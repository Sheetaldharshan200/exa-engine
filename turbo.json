{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "EXA_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "EXA_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "exa#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@exa/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@exa/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@exa/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@exa/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
