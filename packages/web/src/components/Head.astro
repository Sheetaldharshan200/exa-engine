---
import Default from '@astrojs/starlight/components/Head.astro'
import config from '../../config.mjs'

const base = import.meta.env.BASE_URL.replace(/^\//, "").replace(/\/$/, "")

const slug = Astro.url.pathname.replace(/^\//, "").replace(/\/$/, "");
const {
  entry: {
    data: { title },
  },
} = Astro.locals.starlightRoute;
const t = Astro.locals.t as (key: string) => string
const titleSuffix = t("app.head.titleSuffix")
const isHome = slug === "" || slug === base

// One shared card for every page — the docs are served locally by `exa docs`,
// so there is no per-page image service to call.
const ogImage = `${config.url}/social-share.png`;
---

{ isHome && (
<title>{title} | {titleSuffix}</title>
)}

<Default {...Astro.props}><slot /></Default>

<meta property="og:image" content={ogImage} />
<meta property="twitter:image" content={ogImage} />
