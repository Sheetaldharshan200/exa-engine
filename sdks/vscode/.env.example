# Publishing settings for the editor extension.
#
# Copy to .env and fill in. .env is git-ignored — it holds tokens.
#   cp .env.example .env
#
# Nothing here needs a source edit: script/publish reads these and writes the
# publisher into package.json only for the duration of the packaging step, so
# the committed file never carries an account id.

# The publisher id you registered at https://marketplace.visualstudio.com/manage
# It must be the exact id, not the display name. This is the ONE value you
# cannot publish without.
VSCE_PUBLISHER=

# Personal access token from https://dev.azure.com
#   user icon -> Personal access tokens -> New Token
#   Organization: All accessible organizations   <- publishing 401s without this
#   Scopes: Custom defined -> Marketplace -> Manage
# Leave blank to be prompted, or to use a previous `vsce login`.
VSCE_PAT=

# Token from https://open-vsx.org (sign in with GitHub -> Access Tokens).
# Needed only for Cursor, Windsurf and VSCodium, which cannot use Microsoft's
# marketplace. You must also sign the publisher agreement there once, or
# publishing fails with a message that does not mention it.
# Leave blank to skip Open VSX entirely.
OPENVSX_TOKEN=

# Overrides the version that would otherwise come from the newest vscode-v* tag.
# Marketplace versions are permanent and must always increase.
VSCE_VERSION=
